[Unit]
# CheckHook XDP enforcement: attaches the XDP program and pins its blocklist map
# at /sys/fs/bpf/checkhook. Detectors (backend: xdp) only update that map.
# Interface/mode: `xdp:` in /etc/checkhook/checkhook.yaml.
Description=CheckHook XDP enforcement (eBPF blocklist on the NIC)
After=network-online.target
Wants=network-online.target
Before=checkhookd.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__ROOT__
ExecStart=/usr/bin/python3 -m checkhook.xdp load
ExecStop=/usr/bin/python3 -m checkhook.xdp unload

[Install]
WantedBy=multi-user.target
