[Desktop Entry]
Type=Application
Version=1.0
Name=CheckHook
GenericName=AI Firewall
Comment=AI firewall status, alerts, blocklist and LLM review
# Paths below are filled in by install-desktop.sh at install time.
Exec=__CHECKHOOK_DIR__/bin/checkhook gui
Icon=__CHECKHOOK_ICON__
Terminal=false
Categories=Security;Network;System;
Keywords=firewall;xdp;ebpf;nftables;ids;snort;ml;ai;security;
StartupNotify=true
StartupWMClass=CheckHook
