#!/usr/bin/env bash
# checkhook — AI firewall front-end (detection → blocklist → kernel enforcement)
# "fight AI with AI · 이이제이 · kernel-speed enforcement" — CHECK + HOOK
#
# Prints the CheckHook banner, then either shows the menu (no args) or
# dispatches a subcommand to the underlying checkhook/benchmark modules.
# Pure wrapper: it does not change behaviour, it just gives the project a
# single branded entrypoint (the commands you already run still work directly).

set -euo pipefail

# --- locate the repo root (this script lives in <repo>/bin; it may be called
#     through the /usr/local/bin/checkhook symlink) -------------------------------
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"

# --- colours (disabled when stdout is not a TTY or NO_COLOR is set) -----------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  BOLD=$'\e[1m'; DIM=$'\e[2m'; RST=$'\e[0m'
  RED=$'\e[38;5;196m'; CRIMSON=$'\e[38;5;160m'; STEEL=$'\e[38;5;252m'
  CYAN=$'\e[38;5;44m'; GREY=$'\e[38;5;244m'
else
  BOLD=""; DIM=""; RST=""; RED=""; CRIMSON=""; STEEL=""; CYAN=""; GREY=""
fi

VERSION="$(sed -n 's/^__version__ *= *"\(.*\)"/\1/p' checkhook/__init__.py 2>/dev/null || echo '?')"

banner() {
  printf '%s\n' ""
  printf ' %s%s%s%s%s\n' "$STEEL" ' ██████╗██╗  ██╗███████╗ ██████╗██╗  ██╗' "$RED" '██╗  ██╗ ██████╗  ██████╗ ██╗  ██╗' "$RST"
  printf ' %s%s%s%s%s\n' "$STEEL" '██╔════╝██║  ██║██╔════╝██╔════╝██║ ██╔╝' "$RED" '██║  ██║██╔═══██╗██╔═══██╗██║ ██╔╝' "$RST"
  printf ' %s%s%s%s%s\n' "$STEEL" '██║     ███████║█████╗  ██║     █████╔╝ ' "$RED" '███████║██║   ██║██║   ██║█████╔╝' "$RST"
  printf ' %s%s%s%s%s\n' "$STEEL" '██║     ██╔══██║██╔══╝  ██║     ██╔═██╗ ' "$RED" '██╔══██║██║   ██║██║   ██║██╔═██╗' "$RST"
  printf ' %s%s%s%s%s\n' "$STEEL" '╚██████╗██║  ██║███████╗╚██████╗██║  ██╗' "$RED" '██║  ██║╚██████╔╝╚██████╔╝██║  ██╗' "$RST"
  printf ' %s%s%s%s%s\n' "$STEEL" ' ╚═════╝╚═╝  ╚═╝╚══════╝ ╚═════╝╚═╝  ╚═╝' "$RED" '╚═╝  ╚═╝ ╚═════╝  ╚═════╝ ╚═╝  ╚═╝' "$RST"
  printf '\n'
  printf '   %sfight AI with AI%s  %s·%s  %s이이제이%s  %s·%s  %skernel-speed enforcement%s\n' \
         "$BOLD" "$RST" "$GREY" "$RST" "$CYAN" "$RST" "$GREY" "$RST" "$DIM" "$RST"
  printf '   %sv%s  —  slip the rush, land the hook%s\n\n' "$GREY" "$VERSION" "$RST"
}

menu() {
  banner
  cat <<EOF
  ${BOLD}USAGE${RST}
    ${CYAN}checkhook${RST} <command> [options]

  ${BOLD}ENFORCEMENT${RST}  (shared kernel blocklist — nftables or XDP)
    ${CYAN}status${RST}            show the live blocklist (configured backend)
    ${CYAN}block${RST} <ip>        add an IP to the blocklist        ${DIM}(root)${RST}
    ${CYAN}unblock${RST} <ip>      remove an IP                      ${DIM}(root)${RST}
    ${CYAN}setup${RST} / ${CYAN}teardown${RST}  create / remove the nft table    ${DIM}(root)${RST}
    ${CYAN}xdp${RST}               XDP backend status (blocked IPs, drops) ${DIM}(root)${RST}

  ${BOLD}DETECTION${RST}
    ${CYAN}watch${RST}             IDS bridge in the foreground       ${DIM}(checkhook.snort_bridge)${RST}
    ${CYAN}detect${RST}            ML detector in the foreground      ${DIM}(checkhook.ml_detector, root)${RST}
    ${CYAN}triage${RST}            LLM triage report (read-only)      ${DIM}(checkhook.triage)${RST}
    ${DIM}(checkhookd runs all of these in the background)${RST}

  ${BOLD}MODEL / BENCHMARK${RST}
    ${CYAN}train${RST}             train the ML detector              ${DIM}(ml.train)${RST}
    ${CYAN}eval${RST}              measure FPR + pick a threshold     ${DIM}(ml.eval)${RST}
    ${CYAN}bench${RST}             run the enforcement benchmark      ${DIM}(benchmark/)${RST}

  ${BOLD}SERVICES${RST}  (systemd; settings in /etc/checkhook/checkhook.yaml)
    ${CYAN}services${RST}          status of checkhookd and the other units
    ${CYAN}config${RST}            print the effective config
    ${CYAN}logs${RST}              follow checkhookd and IDS logs (Ctrl+C to quit)
    ${CYAN}report${RST}            run LLM triage now and show the report ${DIM}(root)${RST}
    ${CYAN}pause${RST} / ${CYAN}resume${RST}    stop / restart training-data collection ${DIM}(attack practice; root)${RST}
    ${CYAN}stats${RST}             collection and detection summary
    ${CYAN}gui${RST}               open the desktop app

    ${CYAN}version${RST} | ${CYAN}help${RST}
  ${DIM}Detectors default to --dry-run. Enforcement is never automatic.${RST}

EOF
}

need_root() {
  if [[ $EUID -ne 0 ]]; then
    printf '%s!%s this command touches the kernel blocklist and needs root — re-run with %ssudo%s\n' \
           "$RED" "$RST" "$BOLD" "$RST" >&2
  fi
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
  ""|help|-h|--help)        menu ;;
  version|-v|--version)     banner ;;
  xdp)                      need_root; exec python3 -m checkhook.xdp "${@:-status}" ;;
  status|list)              exec python3 -m checkhook.blocklist list "$@" ;;
  block|add)                need_root; exec python3 -m checkhook.blocklist add "$@" ;;
  unblock|remove|del)       need_root; exec python3 -m checkhook.blocklist remove "$@" ;;
  flush)                    need_root; exec python3 -m checkhook.blocklist flush "$@" ;;
  setup)                    need_root; exec python3 -m checkhook.blocklist setup "$@" ;;
  teardown)                 need_root; exec python3 -m checkhook.blocklist teardown "$@" ;;
  watch|snort)              exec python3 -m checkhook.snort_bridge "$@" ;;
  detect|ml)                need_root; exec python3 -m checkhook.ml_detector "$@" ;;
  triage|llm)               exec python3 -m checkhook.triage "$@" ;;
  train)                    exec python3 -m ml.train "$@" ;;
  eval)                     exec python3 -m ml.eval "$@" ;;
  services|svc)
    for u in checkhookd checkhook-ids checkhook-xdp checkhook-capture; do
      printf '  %-22s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"
    done
    printf '  %-22s %s\n' "enforce" "$(python3 -m checkhook.service show 2>/dev/null | sed -n 's/^enforce: //p')"
    printf '  %-22s %s\n' "backend" "$(python3 -m checkhook.service show 2>/dev/null | sed -n 's/^backend: //p')"
    ;;
  config)                   exec python3 -m checkhook.service show "$@" ;;
  logs)                     exec journalctl -fu checkhookd -u checkhook-ids ;;
  report)
    need_root
    python3 -m checkhook.service triage && \
      cat "$(python3 -m checkhook.service show | sed -n '/^triage:/,/^[^ ]/s/^  out: //p')" ;;
  bench|benchmark)          exec bash benchmark/run_bench.sh "$@" ;;
  pause|resume)             need_root; exec python3 -m checkhook.collect "$cmd" "$@" ;;
  stats)                    exec python3 -m checkhook.status "$@" ;;
  gui|app)                  exec python3 -m checkhook.gui "$@" ;;
  ctl)                      exec python3 -m checkhook.ctl "$@" ;;
  *)
    printf '%sunknown command:%s %s\n\n' "$RED" "$RST" "$cmd" >&2
    menu >&2
    exit 2 ;;
esac
